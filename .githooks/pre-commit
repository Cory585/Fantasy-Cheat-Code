#!/bin/sh
# Blocks a commit that adds secrets, .env/key/database files, files over 1 MB, conflict
# markers, or leftover debuggers (scripts/guard.py). Enable once per clone with:
#   git config core.hooksPath .githooks
# Skip in an emergency with `git commit --no-verify` (CI still runs the same checks).

root=$(git rev-parse --show-toplevel)
. "$root/.githooks/find-python"
exec "$PYTHON" "$root/scripts/guard.py" --staged
