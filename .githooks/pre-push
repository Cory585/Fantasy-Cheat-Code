#!/bin/sh
# Before a push: the guard over every commit being pushed (files and commit messages), and
# the lint (ruff, if installed in backend/.venv). CI runs these again, plus the tests.

root=$(git rev-parse --show-toplevel)
. "$root/.githooks/find-python"
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then
    # A new branch: check what isn't on main yet.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=""
    [ -z "$base" ] && continue
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  "$PYTHON" "$root/scripts/guard.py" --range "$range" || status=1
done

if "$PYTHON" -m ruff --version >/dev/null 2>&1; then
  (cd "$root/backend" && "$PYTHON" -m ruff check --quiet .) || status=1
fi

[ "$status" -ne 0 ] && echo "Push stopped. Fix the problems above (or push with --no-verify; CI will still check)." >&2
exit "$status"
